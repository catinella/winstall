#define POSTINST ""
#endif

#define PATH_SPLITTER '/'
#define WFOLDER       "/winstall"

typedef enum {
	W_INSTALL,
	W_UNINSTALL,
	W_HELP,
	_last
} wCmd_t;

#define LOGMSG(...) logMsg(__LINE__, __VA_ARGS__)

